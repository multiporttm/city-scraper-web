{
  // Cloudflare Pages project settings. When this file is in the repo, Pages uses it as the source of truth
  // for these settings (they show as read-only in the dashboard). Secrets are still set in the dashboard.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "city-scraper",
  // What `npm run build` produces: the static site, including public/build/ (the bundled app)
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"]
}
